{
  "name": "simku-offline",
  "private": true,
  "version": "1.0.0",
  "author": "Pihak Sekolah",
  "description": "Sistem Informasi Manajemen Kartu Ujian",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:exe": "electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.300.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-qr-code": "latest",
    "react-router-dom": "^6.21.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.simku.app",
    "productName": "Aplikasi SIMKU",
    "npmRebuild": false,
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    }
  }
}
